# BEGIN SILVERBACK CANONICAL
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^silverback-network\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://www.silverback-network.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>
# END SILVERBACK CANONICAL

# BEGIN SILVERBACK SECURITY
Options -Indexes
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
# END SILVERBACK SECURITY
